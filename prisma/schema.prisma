// IntentScout V1 data model.
//
// Design note: AIAnalysis, PipelineStatus, and Outcome from the spec are
// folded directly onto Opportunity rather than split into separate 1:1
// tables — they never exist independently of an Opportunity and splitting
// them buys no query or evolution benefit at V1 scale. ICP fields live on
// Offer for the same reason: one company has exactly one active offer/ICP
// pair in V1.

// Supabase Postgres. DATABASE_URL should be the pooled (pgbouncer, port
// 6543) connection string for runtime queries; DIRECT_URL is the direct
// (port 5432) connection Prisma needs for migrations. See README.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Company {
  id        String     @id @default(cuid())
  name      String
  users     User[]
  offer     Offer?
  campaigns Campaign[]
  createdAt DateTime   @default(now())
}

/// Offer + ICP definition captured during onboarding (spec section 3).
model Offer {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id])
  verticalTemplateKey String
  businessType        String
  whatYouSell         String
  problemsSolved      String
  idealCustomer       String
  priceRangeMin       Int?
  priceRangeMax       Int?
  geography           String?
  excludedAudiences   String?
  brandVoice          String?
  engagementStyle     String?
  updatedAt           DateTime @updatedAt
}

model Campaign {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  name              String
  status            String             @default("active") // active | paused
  sourceType        String // "reddit" | "manual"
  exclusions        String?
  maxLeadAgeHours   Int                @default(24) // 12 | 24 | 48 | 168 | 720 — how recent a live-scanned post must be to surface at all
  keywords          Keyword[]
  conversations     Conversation[]
  searchSurfaces    SearchSurface[]
  discoveryTerms    DiscoveryTerm[]
  xDiscoveryPhrases XDiscoveryPhrase[]
  scanRuns          ScanRun[]
  createdAt         DateTime           @default(now())
  lastScanAt        DateTime? // set whenever a scan actually runs (manual or scheduled) — never fabricated

  // Hash of the Offer fields (whatYouSell, problemsSolved, idealCustomer,
  // geography, excludedAudiences, businessType) the campaign's current
  // DiscoveryTerm pool was generated from — see lib/ai/discovery.ts's
  // hashOfferForDiscovery. When the live offer's hash no longer matches,
  // the pool is stale (the business materially changed) and gets
  // regenerated lazily on the next scan, without needing to diff the offer
  // text itself every time.
  discoveryOfferHash String?

  // Breakdown of the most recent scan (manual click or cron), so the UI can
  // show real numbers even for scans nobody was watching happen. Null until
  // the first scan ever completes; all set together, in one write, at the
  // end of runScanForCampaign.
  lastScanIngested          Int?
  lastScanSkippedDuplicates Int?
  lastScanSkippedJunk       Int?
  lastScanOpportunities     Int?
  lastScanCacheHit          Boolean?
}

model Keyword {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  term       String
  type       String   @default("keyword") // keyword | subreddit | topic
}

/// A single discovery angle for a campaign's search, beyond the always-on
/// keyword/topic query in redditApisAdapter.ts. Generated once per campaign
/// from the Offer profile (lib/ai/searchSurfaces.ts), then rotated across
/// scans rather than all executed every time — see
/// lib/sources/searchOrchestrator.ts for the rotation/priority logic this
/// feeds. Vertical-agnostic: `family` and `phrases` are always derived from
/// the business's own Offer, never a hardcoded vertical's terminology.
model SearchSurface {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // buyer_request | provider_search | recommendation | problem | solution |
  // goal | planning | comparison | alternative | troubleshooting |
  // dissatisfaction | urgency | beginner_confusion | domain_topic | local
  family     String
  phrases    String // JSON-stringified string[]

  // Exploration/exploitation stats — cumulative, durable rotation state,
  // cheap to read for ranking (see rankSurfaces in
  // lib/sources/searchOrchestrator.ts). Per-execution history (which run,
  // what that specific query returned, cache hit or not) lives in
  // SearchSurfaceRun below instead — these counters answer "recently run?
  // historically high/low yield?" without needing to scan that history.
  timesRun           Int       @default(0)
  lastRunAt          DateTime?
  conversationsFound Int       @default(0) // raw hits across all runs, pre-dedup
  opportunitiesFound Int       @default(0) // genuine opportunities credited to this surface

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs SearchSurfaceRun[]

  @@index([campaignId])
}

/// An individual AI-generated discovery concept — "the language of the
/// problem, not the name of the service." Supersedes SearchSurface above as
/// the thing rotation actually selects from: instead of up to 15 families
/// each bundling up to 8 phrases into one query, a campaign gets a much
/// larger pool (typically 60-300 rows, see DISCOVERY_TERM_TARGET_COUNT) of
/// individually-tracked concepts, so yield learning happens per concept
/// instead of per 8-phrase bundle. Generated by lib/ai/discovery.ts,
/// selected/batched/rotated by lib/sources/searchOrchestrator.ts.
/// SearchSurface/SearchSurfaceRun are kept, unused by new scans, purely so
/// Conversation.foundBySurfaces still resolves on rows ingested before this
/// model shipped — nothing new is written to them.
model DiscoveryTerm {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  term          String
  // service | problem | outcome | task | tool | alternative | frustration |
  // beginner_language | advanced_language | decision_language |
  // recommendation_language | adjacent_concept | other
  category      String
  priority      String // high | medium | low — Gemini's own confidence this concept surfaces real prospects; the base component of rotation weight (see rankTerms)
  promptVersion String // DISCOVERY_PROMPT_VERSION this term was generated under — lets a prompt upgrade trigger regeneration

  // false once superseded by a regeneration (material offer change or a
  // prompt version bump) — kept, not deleted, so historical yield stays
  // queryable even after the active pool moves on.
  active     Boolean   @default(true)
  timesUsed  Int       @default(0)
  lastUsedAt DateTime?

  // Raw hits and genuine opportunities attributed to this specific term —
  // see searchOrchestrator.ts's packTermBatches/literal-match attribution
  // for how credit is split when several terms share one provider call.
  candidatesFound    Int @default(0)
  opportunitiesFound Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, active])
}

/// X/Twitter's own discovery-vocabulary pool — natural, conversational
/// SEARCH PHRASES (roughly 3-9 words, e.g. "don't know what workout plan to
/// use") rather than DiscoveryTerm's short 2-5 word topic concepts (e.g.
/// "workout plan"). X is a conversational medium — people tweet in sentence
/// fragments, not search-engine-style keywords — so its discovery layer
/// leans more heavily on natural buyer-voice phrasing than Reddit's does.
/// Generated by lib/ai/xPhrases.ts from the same Offer profile
/// DiscoveryTerm uses (never anything source- or vertical-specific), rotated
/// by the same rankCandidates/packTermBatches machinery in
/// lib/sources/searchOrchestrator.ts's runXDiscovery. A structural sibling
/// of DiscoveryTerm, not a subtype of it — kept as its own table (rather
/// than reusing DiscoveryTerm with a "style" flag) so X's rotation/yield
/// stats never mix with Reddit's for the same campaign, and so the two
/// generators can evolve independently. Staleness reuses
/// Campaign.discoveryOfferHash — it's the same Offer fingerprint either
/// pool would compare against, so one column suffices for both.
model XDiscoveryPhrase {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phrase        String
  // direct_demand | recommendation | problem | outcome | solution_seeking |
  // alternative | comparison | frustration | tool_product_service |
  // adjacent_concept | customer_language | other
  category      String
  priority      String // high | medium | low — same meaning as DiscoveryTerm.priority
  promptVersion String // X_PHRASE_PROMPT_VERSION this phrase was generated under

  active     Boolean   @default(true)
  timesUsed  Int       @default(0)
  lastUsedAt DateTime?

  candidatesFound    Int @default(0)
  opportunitiesFound Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, active])
}

/// One discovery-layer provider call within a scan — the term-level
/// equivalent of SearchSurfaceRun above. termIds is a JSON-stringified
/// string[] because one call batches several terms into a single OR query
/// (a bounded-provider-call-count requirement, not a retrieval choice) —
/// empty array for the "precision" (manual keyword/topic) call, which isn't
/// part of the rotation pool.
model DiscoveryTermRun {
  id           String   @id @default(cuid())
  scanRunId    String
  scanRun      ScanRun  @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  termIds      String // JSON-stringified string[]
  kind         String // "precision" | "discovery"
  query        String
  rawCount     Int      @default(0)
  keptCount    Int      @default(0) // after the real recency cutoff
  cacheHit     Boolean  @default(false)
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([scanRunId])
}

/// One campaign scan, one row — the durable version of what used to be only
/// ephemeral console.log lines plus five lastScan* fields on Campaign
/// (which only ever remember the MOST RECENT scan). Lets query-level yield
/// ("which surfaces actually produce opportunities?") and lead yield
/// ("opportunities / analyzed", "opportunities / raw results" — never just
/// raw volume) be answered from real history instead of guessed at.
/// Aggregated once, at the end of runScanForCampaign, from the same values
/// already computed for the lastScan* fields plus a provider-usage lookup —
/// deliberately does not touch lib/providers/redditapis/{service,budget,
/// cache,costLedger}.ts, so the ledger's own correctness is never at risk
/// from an observability feature.
model ScanRun {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  durationMs Int?

  rawProviderResults   Int @default(0) // union across all surfaces this run, pre-dedup
  uniqueConversations  Int @default(0) // post-dedup, pre-junk-filter
  skippedJunk          Int @default(0)
  skippedDuplicates    Int @default(0)
  aiAnalyzedCount      Int @default(0) // may be less than uniqueConversations - skippedJunk if MAX_ANALYSIS_PER_SCAN was hit
  opportunitiesCreated Int @default(0)
  discoveryTermsUsed   Int @default(0) // distinct DiscoveryTerm rows actually batched into a query this scan

  // Honest partial-scan accounting: searchesPlanned is the full job list
  // built before execution; searchesSkippedBudget is how many of those
  // never even got attempted because the provider budget ran out before
  // their turn (previously silently dropped from every metric — a scan
  // that planned 11 searches and got budget-cut after 6 used to report
  // exactly the same providerCalls as a scan that genuinely only needed 6).
  // providerCalls (below) is calls actually attempted (success or fail);
  // searchesPlanned - searchesSkippedBudget - providerCalls should be ~0.
  searchesPlanned       Int @default(0)
  searchesSkippedBudget Int @default(0)
  // How many previously-ingested-but-not-yet-analyzed conversations
  // (Conversation.analyzedAt IS NULL, from a prior scan that hit
  // MAX_ANALYSIS_PER_SCAN) were pulled into this scan's analysis queue to
  // fill remaining capacity after this scan's own fresh discoveries — see
  // the backlog logic in lib/pipeline.ts. Distinguishes "this scan found a
  // lot" from "this scan is catching up on a backlog."
  candidatesCarriedOver Int @default(0)

  // Read back from ProviderUsageEvent for this campaign within the run's
  // time window, not written directly — see the note above on why this
  // deliberately never touches the ledger's own write path.
  providerCalls      Int   @default(0)
  providerCacheHits  Int   @default(0)
  providerSpendUsd   Float @default(0)
  providerErrors     Int   @default(0)
  aiErrors           Int   @default(0)
  // Estimate, not a ledger fact like providerSpendUsd above — Gemini has no
  // equivalent per-call usage-event table in this codebase to read back
  // from, so this is aiAnalyzedCount * a fixed per-call cost figure (see
  // ESTIMATED_GEMINI_COST_PER_ANALYSIS_USD in lib/ai/client.ts), which was
  // itself measured from real usageMetadata on live calls, not looked up
  // from a pricing page. Good enough to answer "roughly what did this scan
  // cost end to end," not precise enough to reconcile against a bill.
  estimatedAiCostUsd Float @default(0)

  notConfigured Boolean @default(false)

  surfaceRuns       SearchSurfaceRun[]
  discoveryTermRuns DiscoveryTermRun[]

  @@index([campaignId, startedAt])
}

/// One query execution within one ScanRun. This is the actual answer to
/// "which queries generated conversations/opportunities/mostly junk?" —
/// SearchSurface's cumulative counters can't tell you WHEN or in what
/// specific run a given result came from; this can. searchSurfaceId is
/// null for the campaign's baseline keyword/topic query, which isn't part
/// of the rotation pool.
model SearchSurfaceRun {
  id              String         @id @default(cuid())
  scanRunId       String
  scanRun         ScanRun        @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  searchSurfaceId String?
  searchSurface   SearchSurface? @relation(fields: [searchSurfaceId], references: [id], onDelete: Cascade)
  family          String // includes "baseline"
  query           String
  rawCount        Int            @default(0)
  keptCount       Int            @default(0) // after the real recency cutoff
  cacheHit        Boolean        @default(false)
  success         Boolean        @default(true)
  errorMessage    String?
  createdAt       DateTime       @default(now())

  @@index([scanRunId])
  @@index([searchSurfaceId])
}

/// The normalized object every SourceAdapter must produce. No adapter-specific
/// fields live here beyond the generic `metadata` JSON blob (spec section 4).
model Conversation {
  id              String       @id @default(cuid())
  campaignId      String
  campaign        Campaign     @relation(fields: [campaignId], references: [id])
  source          String // "reddit" | "manual"
  sourceId        String? // external id for dedup; null for manual imports
  authorRef       String?
  title           String?
  originalText    String
  url             String
  community       String?
  postedAt        DateTime
  ingestedAt      DateTime     @default(now())
  // Set once Gemini has produced a real verdict for this conversation —
  // regardless of whether it became an Opportunity. This is what makes
  // "never analyzed" distinguishable from "analyzed and correctly
  // rejected": before this field existed, both looked identical (no
  // Opportunity row), so there was no safe way to find conversations that
  // were ingested but silently dropped when a scan hit
  // MAX_ANALYSIS_PER_SCAN — they just stayed unanalyzed forever. Null for
  // every row ingested before this field shipped; those become a one-time
  // backlog that gets genuinely analyzed (not just fabricated as "already
  // handled") the next time capacity allows — see runScanForCampaign's
  // backlog carryover logic in lib/pipeline.ts.
  analyzedAt      DateTime?
  metadata        String? // opaque JSON, source-specific, never read by analysis/UI logic
  // JSON-stringified string[] of SearchSurface ids — legacy provenance from
  // the retired family-bundle rotation system. Null for rows ingested after
  // DiscoveryTerm shipped; kept only so old conversations still resolve
  // their original "discovered through" data. Never written to going forward.
  foundBySurfaces String?
  // JSON-stringified string[] of DiscoveryTerm ids (or "precision") whose
  // query returned this post in the scan that first ingested it — current
  // provenance mechanism. A post found by several terms/batches still
  // becomes exactly one Conversation; this is how yield gets credited back
  // to every term that actually found it (see creditOpportunityToTerms).
  foundByTerms    String?
  opportunity     Opportunity?

  @@unique([source, sourceId])
  @@index([campaignId, analyzedAt])
}

model Opportunity {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // --- five distinct intelligence dimensions (spec section 5 / 22) ---
  intentScore  Int
  fitScore     Int
  matchScore   Int
  confidence   String // low | medium | high
  safetyLabel  String // safe | caution | not_safe
  safetyReason String

  detectedNeed      String
  whyNow            String
  reasoning         String // JSON-stringified string[]
  recommendedAction String // comment | dm | monitor | none
  // tool_request | alternative_search | comparison | hiring_outsourcing |
  // troubleshooting | pain_frustration | exploring_solutions | other.
  // Nullable — rows analyzed before this field existed have no value.
  intentCategory    String?
  priorityTier      String // high | potential | low
  promptVersion     String
  analyzedAt        DateTime @default(now())

  // --- lightweight pipeline (spec section 10) ---
  status         String  @default("new") // new|reviewed|saved|dismissed|contacted|replied|qualified|won|lost
  estimatedValue Int?
  outcome        String? // won | lost, set when status reaches a terminal state

  // Set only when the user explicitly marks Contacted — distinct from a draft merely
  // being generated. IntentScout never sets these itself; it never sends anything.
  contactedAt    DateTime?
  engagementType String? // comment | dm | other — which channel the user actually used
  finalResponse  String? // optional: what the user actually sent, if they want it on record

  engagementRecommendations EngagementRecommendation[]
  activity                  Activity[]
}

model EngagementRecommendation {
  id             String        @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id])
  strategy       String // comment | dm | monitor | none
  strategyReason String
  avoidGuidance  String? // "what NOT to say" — spec section 9
  createdAt      DateTime      @default(now())
  commentDraft   CommentDraft?
  dmDraft        DMDraft?
}

model CommentDraft {
  id                         String                   @id @default(cuid())
  engagementRecommendationId String                   @unique
  engagementRecommendation   EngagementRecommendation @relation(fields: [engagementRecommendationId], references: [id])
  text                       String
  whyThisResponse            String
  version                    Int                      @default(1)
  createdAt                  DateTime                 @default(now())
}

model DMDraft {
  id                         String                   @id @default(cuid())
  engagementRecommendationId String                   @unique
  engagementRecommendation   EngagementRecommendation @relation(fields: [engagementRecommendationId], references: [id])
  text                       String
  whyThisResponse            String
  version                    Int                      @default(1)
  createdAt                  DateTime                 @default(now())
}

model Activity {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  event         String
  note          String?
  at            DateTime    @default(now())
}

/// Every call made to an external ingestion provider (currently only
/// Redditapis), successful or not, priced or free. This is the ledger the
/// budget guard and margin/health reporting read from — never inferred,
/// always recorded at the moment the call happens.
model ProviderUsageEvent {
  id           String   @id @default(cuid())
  provider     String // "redditapis"
  endpoint     String // e.g. "GET /api/reddit/search"
  requestType  String // "search" | "posts" | "account"
  campaignId   String?
  companyId    String?
  unitCostUsd  Float // 0 for free endpoints
  cacheHit     Boolean  @default(false) // true when served from ProviderRequestCache — no spend, still logged
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
  @@index([campaignId])
}

/// Short-TTL cache of provider responses keyed by the exact request made.
/// Purely a spend guard — if the same campaign fires the same query twice
/// inside the TTL window (e.g. a double click), the second call is served
/// from here instead of paying Redditapis again.
model ProviderRequestCache {
  id           String   @id @default(cuid())
  provider     String
  cacheKey     String   @unique
  responseJson String // JSON-stringified provider response
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}
