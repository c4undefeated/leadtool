# Copy to .env and fill in. See README.md for what each is for and what
# happens when a given variable is left unset.

# SQLite file for local dev. Swap the provider in prisma/schema.prisma to
# "postgresql" and point this at a real Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Signs session cookies. Any long random string. Required — auth will not
# work without it.
SESSION_SECRET="change-me-to-a-long-random-string"

# Required for the AI analysis and engagement-drafting pipeline. Without
# this set, analysis requests fail with a clear "not configured" error —
# the app does not fabricate scores or drafts to fill the gap.
ANTHROPIC_API_KEY=""

# Optional. Only needed to enable live Reddit ingestion. Until IntentScout
# has filed and received Reddit's Responsible Builder + commercial-use
# approval (see README.md), leave these unset and use the manual-import
# validation pathway instead — the product is fully usable without them.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="IntentScout/0.1 (by /u/your-account)"
