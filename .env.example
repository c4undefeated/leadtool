# Copy to .env and fill in. See README.md for what each is for and what
# happens when a given variable is left unset.

# Supabase Postgres. DATABASE_URL is the shared pooler in transaction mode
# (port 6543, via Supavisor — used at runtime by the app). DIRECT_URL is
# the true direct connection (port 5432) Prisma needs for migrations.
# Both come from the same Supabase project — click "Connect" at the top of
# the project dashboard to get the password-filled versions of these.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Signs session cookies. Any long random string. Required — auth will not
# work without it.
SESSION_SECRET="change-me-to-a-long-random-string"

# Required for the AI analysis and engagement-drafting pipeline. Without
# this set, analysis requests fail with a clear "not configured" error —
# the app does not fabricate scores or drafts to fill the gap.
GEMINI_API_KEY=""

# Optional. Override the model per stage — both default to gemini-3.6-flash
# (the current stable Flash release) if unset.
# INTENTSCOUT_ANALYSIS_MODEL="gemini-3.6-flash"
# INTENTSCOUT_ENGAGEMENT_MODEL="gemini-3.6-flash"

# Optional. Only needed to enable live Reddit ingestion. Server-side only —
# never exposed to the client, never logged, never committed. Redditapis
# (api.redditapis.com) is a third-party data provider, NOT Reddit's official
# API and not affiliated with Reddit; see README.md for what that means and
# what IntentScout does and does not do with it (read-only, always). Until
# this is set, leave it unset and use the manual-import validation pathway
# instead — the product is fully usable without it.
REDDITAPIS_API_KEY=""

# Optional. Caps lifetime Redditapis spend recorded in the cost ledger as a
# testing-phase safety guard. Defaults to 0.50 (USD) if unset — see
# lib/providers/redditapis/budget.ts.
# REDDITAPIS_MAX_TEST_SPEND_USD="0.50"

# Optional. Only needed to enable live X/Twitter ingestion. Same rules as
# REDDITAPIS_API_KEY above — server-side only, read-only, TwitterAPIs
# (api.twitterapis.com) is a third-party data provider, NOT X's official
# API and not affiliated with X. See README.md.
TWITTER_API_KEY=""

# Optional. Same idea as REDDITAPIS_MAX_TEST_SPEND_USD, for TwitterAPIs.
# Defaults to 0.50 (USD) if unset — see lib/providers/twitterapis/budget.ts.
# TWITTER_MAX_TEST_SPEND_USD="0.50"

# Required for scheduled scanning (app/api/cron/scan-campaigns) to do
# anything other than 401. Vercel automatically sends this as a Bearer
# token when it invokes the cron job, once the env var is set on the
# project — generate any long random string, e.g. `openssl rand -hex 32`.
# Without it, scheduled scanning is simply inert; the underlying scan
# function still works if manually re-enabled (see ENABLE_MANUAL_SCAN_UI).
CRON_SECRET=""

# --- Always-on daily scanning (lib/dailyScan.ts) ---
# All optional, all have sane defaults — only set these to change the
# defaults for a specific deployment.

# How many hours must pass since a campaign's last COMPLETED scan before
# it's due again. Default 20 — comfortably under 24h so a cron invocation
# landing a little early/late each day still fires once daily.
# SCAN_DUE_THRESHOLD_HOURS="20"

# How long a campaign-level scan lock is honored before it's considered
# stale and eligible to be re-claimed (protects against a crashed process
# holding a lock forever). Default 10 minutes.
# SCAN_LOCK_LEASE_MINUTES="10"

# How many campaigns the daily scan processes concurrently. Default 3 —
# chosen to avoid provider bursts and DB connection pressure; each
# campaign's own scan already runs its own internal concurrency on top of
# this.
# CAMPAIGN_CONCURRENCY="3"

# Soft wall-clock budget (ms) for one daily-scan invocation before it stops
# claiming NEW campaigns (any already in flight are allowed to finish).
# Default 50000 (50s) — comfortably under Vercel Hobby tier's hard 60s
# function ceiling. Campaigns not reached in time stay due and are picked
# up by the next invocation.
# DAILY_SCAN_TIME_BUDGET_MS="50000"

# Production users no longer see a manual "Run scan" button — campaigns
# scan automatically once a day (lib/dailyScan.ts). Set to "true" to bring
# the button back for local/internal testing; the underlying scan action
# is never removed, just not rendered by default.
# ENABLE_MANUAL_SCAN_UI="false"
